# Environment Variables (Never commit secrets! Use .env locally)
# Copy this to .env and fill in your values

# Algorand RPC (use public nodes by default, upgrade if needed)
ALGOD_HOST=localhost
ALGOD_PORT=4001
ALGOD_TOKEN=

# Indexer (Nodely or AlgoNode for mainnet)
INDEXER_HOST=api.algonode.cloud
INDEXER_PORT=443
INDEXER_USE_HTTPS=true

# Wallet & Keys (NEVER commit these!)
HOT_WALLET_ADDRESS=
HOT_WALLET_SEED_PHRASE=
COLD_WALLET_ADDRESS=

# Telegram Alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# VPS Deployment
VPS_HOST=
VPS_USER=algobot
VPS_KEY_PATH=~/.ssh/id_ed25519

# Database
LEDGER_DB_PATH=/data/ledger.db
BACKUP_DIR=/data/backups

# Optional: Monitoring
HEALTHCHECKS_IO_URL=
PROMETHEUS_ENABLED=false

# Logging
LOG_LEVEL=INFO
LOG_FILE=/data/logs/bot.log

# Application Mode
APP_MODE=shadow  # "shadow" (detection only) or "live" (execution)
